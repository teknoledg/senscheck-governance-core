{
  "name": "senscheck-governance-core-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "SensCheck Governance — Core. Fail-closed governance for AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "clean": "pnpm -r run clean",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "validate:plugins": "node scripts/validate-plugins.mjs",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm validate:schemas && pnpm validate:plugins",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.17.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11",
    "zod": "^3.23.0"
  }
}
