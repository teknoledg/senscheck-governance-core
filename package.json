{
  "name": "senscheck-governance-core-monorepo",
  "private": true,
  "version": "0.3.0",
  "description": "SensCheck Governance — Core. Fail-closed governance for AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "clean": "pnpm -r run clean",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "validate:plugins": "node scripts/validate-plugins.mjs",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm validate:schemas && pnpm validate:plugins",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.17.0",
    "eslint": "^10.15.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "body-parser": "^2.4.0",
      "ip-address": "^10.7.4",
      "fast-uri": "^3.1.9",
      "qs": "^6.16.1",
      "@hono/node-server": "^2.1.6",
      "hono": "^4.13.16"
    }
  }
}
